{
  "name": "aracze",
  "version": "1.0.0",
  "description": "A blank template to get started with Payload 3.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "build:email-assets": "node scripts/build-email-assets.mjs",
    "build:map-style": "node scripts/build-map-style.mjs",
    "format": "prettier --write .",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "promote:admin": "cross-env NODE_OPTIONS=--no-deprecation node --import=tsx/esm scripts/promote-admin.ts",
    "backfill:affiliate-deals": "cross-env NODE_OPTIONS=--no-deprecation node --import=tsx/esm scripts/backfill-affiliate-deals.ts",
    "backup:avatars": "cross-env NODE_OPTIONS=--no-deprecation node --import=tsx/esm scripts/backup-avatars-r2.ts",
    "cleanup:place-detail": "docker compose exec -T postgres psql -U postgres -d aracze -f - < scripts/cleanup-currency-timezone.sql",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "test": "pnpm run test:int && pnpm run test:e2e",
    "test:e2e": "cross-env NODE_OPTIONS=--no-deprecation playwright test --config=playwright.config.ts",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1090.0",
    "@google-analytics/data": "^7.0.0",
    "@payloadcms/db-postgres": "3.86.0",
    "@payloadcms/email-nodemailer": "3.86.0",
    "@payloadcms/next": "3.86.0",
    "@payloadcms/plugin-cloud-storage": "3.86.0",
    "@payloadcms/plugin-nested-docs": "3.86.0",
    "@payloadcms/plugin-seo": "3.86.0",
    "@payloadcms/richtext-lexical": "3.86.0",
    "@payloadcms/ui": "3.86.0",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-slot": "^1.3.0",
    "clsx": "^2.1.1",
    "cross-env": "^7.0.3",
    "dompurify": "^3.4.12",
    "dotenv": "16.4.7",
    "fast-xml-parser": "^5.10.1",
    "fuse.js": "^7.5.0",
    "graphql": "^16.8.1",
    "isomorphic-dompurify": "^3.19.0",
    "lucide-react": "^1.25.0",
    "maplibre-gl": "^6.1.0",
    "next": "16.2.10",
    "payload": "3.86.0",
    "payload-storage-cloudinary": "^1.2.1",
    "photoswipe": "^5.4.4",
    "qs": "^6.15.3",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "remove-markdown": "^0.6.4",
    "sharp": "0.34.2",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@playwright/test": "1.61.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react": "16.3.2",
    "@types/node": "24.13.3",
    "@types/qs": "^6.15.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "cloudinary": "^2.10.0",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.2.10",
    "jsdom": "29.1.1",
    "mysql2": "^3.23.0",
    "playwright": "1.61.1",
    "playwright-core": "1.61.1",
    "prettier": "^3.9.5",
    "tailwindcss": "^4.3.3",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=24",
    "pnpm": "^10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver"
    ]
  },
  "packageManager": "pnpm@10.32.1+sha512.a706938f0e89ac1456b6563eab4edf1d1faf3368d1191fc5c59790e96dc918e4456ab2e67d613de1043d2e8c81f87303e6b40d4ffeca9df15ef1ad567348f2be"
}
