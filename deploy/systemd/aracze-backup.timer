[Unit]
Description=Denní záloha databáze aracze (01:30 UTC = 03:30 letního času)

[Timer]
OnCalendar=*-*-* 01:30:00
# Rozptyl, aby všechny stroje netloukly do R2 v tutéž sekundu.
RandomizedDelaySec=15m
# Když byl server v čase zálohy vypnutý, doběhne po startu.
Persistent=true

[Install]
WantedBy=timers.target
